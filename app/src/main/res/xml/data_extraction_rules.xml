<?xml version="1.0" encoding="utf-8"?>
<!-- Defense in depth: automatic backup is disabled in AndroidManifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="blacklist.db" />
        <exclude domain="database" path="blacklist.db-wal" />
        <exclude domain="database" path="blacklist.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="blacklist.db" />
        <exclude domain="database" path="blacklist.db-wal" />
        <exclude domain="database" path="blacklist.db-shm" />
    </device-transfer>
</data-extraction-rules>
